-- 💨 EVADE
-- =============================================================================
local Evade = {
    Enabled = false,
    Distance = 200,
    Delay = 1.5,
    MinHeight = -50,
    MaxHeight = 150,
    Direction = 360
}
local LastEvade = os.clock()

local function EvadeNow()
    if not RootPart then return end
    LastEvade = os.clock()
    local angle = Evade.Direction == 360 and math.random() * math.pi * 2 or math.rad(Evade.Direction)
    pcall(function()
        RootPart.CFrame = CFrame.new(RootPart.Position + Vector3.new(
            math.cos(angle)*Evade.Distance,
            math.random(Evade.MinHeight, Evade.MaxHeight),
            math.sin(angle)*Evade.Distance
        ))
    end)
end

local function UpdateEvade()
    if not RootPart or not Evade.Enabled then return end
    if os.clock() - LastEvade >= Evade.Delay then EvadeNow() end
end

