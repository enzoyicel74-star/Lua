local function LoadObsidianUI()
    local repos = {
        "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/",
        "https://raw.githubusercontent.com/deividcomsono/Obsidian/master/",
    }
    for _, repo in ipairs(repos) do
        local ok, result = pcall(function()
            local lib = loadstring(game:HttpGet(repo .. "Library.lua"))()
            local tm, sm = nil, nil
            pcall(function() tm = loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))() end)
