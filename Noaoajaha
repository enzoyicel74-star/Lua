-- 👻 VOID HIDE
-- =============================================================================
local VoidHide = {
    Enabled = false,
    Height = 50000,
    Transparency = 0.8,
    GhostMode = true,
    NoCollision = true,
    HideName = false
}
local OriginalParent = nil
local OriginalTransparency = {}
local OriginalCanCollide = {}
local OriginalDisplayName = nil

local function HideCharacter()
    if not LocalCharacter or OriginalParent then return end
    OriginalParent = LocalCharacter.Parent
    for _, d in ipairs(LocalCharacter:GetDescendants()) do
        if d:IsA("BasePart") then
            OriginalTransparency[d] = d.Transparency
            OriginalCanCollide[d] = d.CanCollide
            d.Transparency = VoidHide.GhostMode and VoidHide.Transparency or 1
            d.CanCollide = not VoidHide.NoCollision
        end
    end
    if VoidHide.HideName then
        local hum = LocalCharacter:FindFirstChild("Humanoid")
        if hum then OriginalDisplayName = hum.DisplayName; hum.DisplayName = "" end
    end
    LocalCharacter.Parent = Workspace.Terrain
    if RootPart then RootPart.CFrame = CFrame.new(0, VoidHide.Height, 0) end
end

local function ShowCharacter()
    if not LocalCharacter or not OriginalParent then return end
    for part, t in pairs(OriginalTransparency) do
        if part then
            part.Transparency = t
            part.CanCollide = OriginalCanCollide[part]
        end
    end
    if OriginalDisplayName then
        local hum = LocalCharacter:FindFirstChild("Humanoid")
        if hum then hum.DisplayName = OriginalDisplayName end
    end
    LocalCharacter.Parent = OriginalParent
    OriginalParent = nil
    table.clear(OriginalTransparency)
    table.clear(OriginalCanCollide)
end

local function UpdateVoidHide()
    if not RootPart then return end
    if VoidHide.Enabled then
        if not OriginalParent then HideCharacter() end
        pcall(function() RootPart.CFrame = CFrame.new(0, VoidHide.Height, 0) end)
    else
        if OriginalParent then ShowCharacter() end
    end
end

