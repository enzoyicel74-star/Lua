-- GET CLOSEST PLAYER
local function GetClosestPlayer(maxRange)
    if not RootPart then return nil end
    maxRange = maxRange or math.huge
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        local char = p.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if hrp and hum and hum.Health > 0 then
            local dist = (RootPart.Position - hrp.Position).Magnitude
            if dist < bestDist and dist <= maxRange then
                bestDist, best = dist, p
            end
        end
    end
    return best
end

-- =============================================================================
-- 🎯 PREDICTION
-- =============================================================================
local Prediction = {
    Enabled = false,
    Amount = 0.15,
    VelocityBased = true,
    Vertical = true,
    Smoothness = 0.5
}
local PlayerVelocity = {}

local function UpdatePlayerVelocity(player)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local state = PlayerVelocity[player] or {LastPos = hrp.Position, LastTime = os.clock(), Velocity = Vector3.new()}
    local now = os.clock()
    local dt = now - state.LastTime
    if dt > 0 and dt < 1 then
        state.Velocity = (hrp.Position - state.LastPos) / dt
    end
    state.LastPos = hrp.Position
    state.LastTime = now
    PlayerVelocity[player] = state
end

local function GetPredictedPosition(player, timeOffset)
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    UpdatePlayerVelocity(player)
    local state = PlayerVelocity[player]
    if not state or not state.Velocity or state.Velocity.Magnitude < 0.1 or not Prediction.Enabled then
        return hrp.Position
    end
    local predicted = hrp.Position + state.Velocity * (timeOffset or Prediction.Amount)
    if not Prediction.Vertical then
        predicted = Vector3.new(predicted.X, hrp.Position.Y, predicted.Z)
    end
    return predicted
end

-- =============================================================================
-- 🛡️ ANTI AIM
-- =============================================================================
local AntiAim = {
    Enabled = false,
    Mode = "Spin",
    SpinSpeed = 180,
    JitterAmount = 45,
    BackwardsOffset = 180,
    Randomize = true
}
local AntiAimAngle = 0

local function UpdateAntiAim(dt)
    if not RootPart or not AntiAim.Enabled then return end
    AntiAimAngle += math.rad(AntiAim.SpinSpeed) * dt
    local finalAngle = 0
    if AntiAim.Mode == "Spin" then
        finalAngle = AntiAimAngle
    elseif AntiAim.Mode == "Jitter" then
        finalAngle = math.rad(math.sin(os.clock() * 10) * AntiAim.JitterAmount)
        if AntiAim.Randomize then
            finalAngle += math.rad(math.random(-15, 15))
        end
    elseif AntiAim.Mode == "Backwards" then
        finalAngle = math.rad(AntiAim.BackwardsOffset + (AntiAim.Randomize and math.random(-15, 15) or 0))
    end
    pcall(function()
        RootPart.CFrame = CFrame.new(RootPart.Position, RootPart.Position + Vector3.new(math.cos(finalAngle), 0, math.sin(finalAngle)))
    end)
end

-- =============================================================================
-- 🔥 RIOT (from original script)
-- =============================================================================
local Riot = {
    Enabled = false,
    Speed = 1000,
    Range = 500,
    Spin = true,
    SpinSpeed = 360
}
local RiotAngle = 0

local function UpdateRiot(dt)
    if not RootPart or not Riot.Enabled then return end
    local target = GetClosestPlayer(Riot.Range)
    if not target or not target.Character then return end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    RiotAngle += math.rad(Riot.SpinSpeed) * dt
    local dir = (hrp.Position - RootPart.Position).Unit * Riot.Speed
    pcall(function()
        RootPart.AssemblyLinearVelocity = Vector3.new(dir.X, 0, dir.Z)
        if Riot.Spin then
            RootPart.CFrame *= CFrame.Angles(0, math.rad(Riot.SpinSpeed) * dt, 0)
        end
    end)
end

