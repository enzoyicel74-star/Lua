    Speed = 5000,
    Altitude = 50000,
    SpinSpeed = 0,
    Gravity = 0,
    RandomX = true,
    RandomY = true,
    RandomZ = true
}

local function UpdateVoidSpam()
    if not RootPart or not VoidSpam.Enabled then return end
    pcall(function()
        local vx = VoidSpam.RandomX and (math.random()-0.5)*VoidSpam.Speed or 0
        local vy = VoidSpam.RandomY and (math.random()-0.5)*VoidSpam.Speed or VoidSpam.Gravity
        local vz = VoidSpam.RandomZ and (math.random()-0.5)*VoidSpam.Speed or 0
        RootPart.CFrame = CFrame.new(RootPart.Position.X, VoidSpam.Altitude, RootPart.Position.Z)
        RootPart.AssemblyLinearVelocity = Vector3.new(vx, vy, vz)
        if VoidSpam.SpinSpeed > 0 then
            RootPart.CFrame *= CFrame.Angles(0, math.rad(VoidSpam.SpinSpeed)*os.clock(), 0)
        end
    end)
end

-- =============================================================================
-- 🌀 ORBIT
-- =============================================================================
local Orbit = {
    Enabled = false,
    Speed = 360,
    Radius = 30,
    Height = 5,
    Tilt = 0,
    Range = 500,
    UsePrediction = true
}
local OrbitAngle = 0

local function UpdateOrbit(dt)
    if not RootPart or not Orbit.Enabled then return end
    local target = GetClosestPlayer(Orbit.Range)
    if not target then return end
    local targetPos
    if Orbit.UsePrediction and Prediction.Enabled then
        targetPos = GetPredictedPosition(target)
    else
        local hrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        targetPos = hrp and hrp.Position
    end
    if not targetPos then return end
    OrbitAngle += math.rad(Orbit.Speed) * dt
    local x, z = math.cos(OrbitAngle)*Orbit.Radius, math.sin(OrbitAngle)*Orbit.Radius
    pcall(function()
        RootPart.CFrame = CFrame.new(targetPos + Vector3.new(x, Orbit.Height, z)) * CFrame.Angles(math.rad(Orbit.Tilt), 0, 0)
    end)
end

-- =============================================================================
-- 🎯 TRANSLOCATE
-- =============================================================================
local Translocate = {
    Enabled = false,
    Range = 1000,
    Offset = 8,
    MinDistance = 15,
    Lift = 0,
    UsePrediction = true
}

local function UpdateTranslocate()
    if not RootPart or not Translocate.Enabled then return end
    local target = GetClosestPlayer(Translocate.Range)
    if not target then return end
    local targetPos
    if Translocate.UsePrediction and Prediction.Enabled then
        targetPos = GetPredictedPosition(target)
    else
        local hrp = target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        targetPos = hrp and hrp.Position
    end
    if not targetPos then return end
    local dist = (RootPart.Position - targetPos).Magnitude
    if dist < Translocate.MinDistance then return end
    pcall(function()
        local dir = (targetPos - RootPart.Position).Unit * Translocate.Offset
        RootPart.CFrame = CFrame.new(targetPos - dir + Vector3.new(0, Translocate.Lift, 0))
    end)
end

