local function getToolsInBackpack()
    local t = {}
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then for _, i in ipairs(bp:GetChildren()) do if i:IsA("Tool") then table.insert(t, i.Name) end end end
    return t
end
local function getToolsInCharacter()
    local t = {}
    if char then for _, i in ipairs(char:GetChildren()) do if i:IsA("Tool") then table.insert(t, i.Name) end end end
    return t
end
local function getAllTools()
    local t, seen = {}, {}
    for _, n in ipairs(getToolsInBackpack()) do if not seen[n] then seen[n] = true; table.insert(t, n) end end
    for _, n in ipairs(getToolsInCharacter()) do if not seen[n] then seen[n] = true; table.insert(t, n) end end
    return t
end
local function findToolByName(name)
    if not char then return nil end
    for _, i in ipairs(char:GetChildren()) do if i:IsA("Tool") and i.Name == name then return i end end
    return nil
end
local function findToolInBackpack(name)
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not bp then return nil end
    for _, i in ipairs(bp:GetChildren()) do if i:IsA("Tool") and i.Name == name then return i end end
    return nil
end
local function getEquippedTool()
    if not char then return nil end
    for _, i in ipairs(char:GetChildren()) do if i:IsA("Tool") then return i end end
    return nil
end
local function equipWeapon(weaponType)
    local name
    if weaponType == "Primary" then name = ragePrimaryWeapon
    elseif weaponType == "Secondary" then name = rageSecondaryWeapon
    else name = rageMeleeWeapon end
    if not name or name == "Auto" or name == "" then return end
    local equipped = getEquippedTool()
    if equipped and equipped.Name == name then return end
    local tool = findToolByName(name) or findToolInBackpack(name)
    if tool and hum and tool.Parent ~= char then pcall(function() hum:EquipTool(tool) end) end
end

local function buildRemoteCache()
    local cache = {}
    local rs = game:GetService("ReplicatedStorage")
    local keywords = {"fire","shoot","attack","hit","click","damage","dmg","bullet","weapon","gun","kill","slice","stab","swing","melee","ray","projectile","cast"}
    for _, remote in ipairs(rs:GetDescendants()) do
        if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
            local n = remote.Name:lower()
            for _, kw in ipairs(keywords) do
                if n:find(kw) then table.insert(cache, {remote = remote, isFunc = remote:IsA("RemoteFunction")}) break end
            end
        end
    end
    return cache
end

local function getRemoteCache()
    if not rageRemoteCache or tick() - rageRemoteCacheTime > 30 then
        rageRemoteCache = buildRemoteCache()
        rageRemoteCacheTime = tick()
    end
    return rageRemoteCache
end

local function updateBacktrackCache()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not p.Character then rageBacktrackCache[p] = nil; continue end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        if not rageBacktrackCache[p] then rageBacktrackCache[p] = {} end
        local c = rageBacktrackCache[p]
        table.insert(c, {pos = hrp.Position, time = tick()})
        while #c > 0 and tick() - c[1].time > 0.3 do table.remove(c, 1) end
    end
end

local function getBacktrackPos(p)
    local c = rageBacktrackCache[p]
    if not c or #c == 0 then return nil end
    local targetTime = tick() - rageBacktrackTime
    local best, bestDiff = nil, math.huge
    for _, entry in ipairs(c) do
        local diff = math.abs(entry.time - targetTime)
        if diff < bestDiff then bestDiff = diff; best = entry.pos end
    end
    return best
end

local function applyHitboxExpand()
    if not rageHitboxExpand then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not p.Character then continue end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        if not hrp:FindFirstChild("RageHitboxMarker") then
            local size = Vector3.new(rageHitboxSize, rageHitboxSize, rageHitboxSize)
            pcall(function()
                hrp.Size = size
                hrp.Transparency = 1
                hrp.CanCollide = false
                local marker = Instance.new("BoolValue")
                marker.Name = "RageHitboxMarker"
                marker.Parent = hrp
            end)
        end
    end
end

local function clearHitboxExpand()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:FindFirstChild("RageHitboxMarker") then
            pcall(function()
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
                hrp.CanCollide = false
                hrp.RageHitboxMarker:Destroy()
            end)
        end
    end
end

local function getAimPart(plr)
    if not plr.Character then return nil end
    if rageAimPart == "Head" then return plr.Character:FindFirstChild("Head")
    elseif rageAimPart == "UpperTorso" then return plr.Character:FindFirstChild("UpperTorso") or plr.Character:FindFirstChild("Torso")
    else return plr.Character:FindFirstChild("HumanoidRootPart") end
end

local function getRageTarget()
    if not root then return nil end
    local cam = workspace.CurrentCamera
    local best, bestScore = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if rageTeamCheck and p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team then continue end
        if not p.Character then continue end
        local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end
        local aimPart = getAimPart(p)
        if not aimPart then continue end

        local screenPos, onScreen = cam:WorldToViewportPoint(aimPart.Position)
        if not onScreen and rageFOVMode == "Circle" then continue end
        local center = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
        local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if rageFOVMode == "Circle" and distToCenter > rageFOV then continue end

        local score
        if rageTargetMode == "Health" then score = humanoid.Health
        elseif rageTargetMode == "Distance" then score = (root.Position - aimPart.Position).Magnitude
        else score = distToCenter end
        if score < bestScore then bestScore = score; best = p end
    end
    return best
end

local function createFOVCircle()
    if rageFOVCircle then rageFOVCircle:Remove() end
    local c = Drawing.new("Circle")
    c.Thickness = 1
    c.NumSides = 80
    c.Radius = rageFOV
    c.Filled = false
    c.Transparency = 1
    c.Color = Color3.fromRGB(255, 60, 60)
    c.Visible = false
    rageFOVCircle = c
end

local function updateFOVCircle()
    if not rageFOVCircle then return end
    if not rageEnabled or rageFOVMode ~= "Circle" then
        rageFOVCircle.Visible = false
        return
    end
    local cam = workspace.CurrentCamera
    rageFOVCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
    rageFOVCircle.Radius = rageFOV
    rageFOVCircle.Visible = true
end

local function aimAt(target)
    local aimPart = getAimPart(target)
    if not aimPart then return end
    local targetPos = aimPart.Position

    if rageBacktrack then
        local bt = getBacktrackPos(target)
        if bt then targetPos = bt end
    end

    local cam = workspace.CurrentCamera
    local myPos = cam.CFrame.Position
    local desired = CFrame.new(myPos, targetPos)
    if rageSmoothing >= 1 then cam.CFrame = desired
    else cam.CFrame = cam.CFrame:Lerp(desired, rageSmoothing) end

    if root then
        local lookDir = targetPos - root.Position
        if lookDir.Magnitude > 0.01 then
            root.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(lookDir.X, 0, lookDir.Z))
        end
    end
end

local function doAutoPeek(dt)
    if not rageAutoPeek or not root or not rageLockedTarget then return end
    local target = rageLockedTarget
    if not target.Character then return end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    ragePeekState = ragePeekState + dt
    local peek = math.sin(ragePeekState * 8) * ragePeekDist
    local toTarget = (hrp.Position - root.Position)
    local perp = Vector3.new(-toTarget.Z, 0, toTarget.X).Unit
    pcall(function()
        root.CFrame = root.CFrame + perp * peek * dt
    end)
end

local function fireWeapon()
    if not rageAutoFire then return end
    if tick() - rageLastShot < rageShootDelay then return end
    rageLastShot = tick()

    local tool = getEquippedTool()
    if tool then
        pcall(function() tool:Activate() end)
        for _, c in ipairs(tool:GetDescendants()) do
            if c:IsA("RemoteEvent") then pcall(function() c:FireServer() end) end
            if c:IsA("RemoteFunction") then pcall(function() c:InvokeServer() end) end
        end
    end

    local cache = getRemoteCache()
    for _, entry in ipairs(cache) do
        if entry.isFunc then pcall(function() entry.remote:InvokeServer() end)
        else pcall(function() entry.remote:FireServer() end) end
    end
end

local function rageBotLoop(dt)
    if not rageEnabled or not root or not hum or hum.Health <= 0 then
        if rageFOVCircle then rageFOVCircle.Visible = false end
        return
    end

    updateFOVCircle()
    updateBacktrackCache()
    applyHitboxExpand()
    equipWeapon(rageWeaponType)

    local target = getRageTarget()
    if not target then rageLockedTarget = nil; return end

    if rageLockedTarget ~= target and tick() - rageLastTargetSwitch > 0.1 then
        rageLockedTarget = target
        rageLastTargetSwitch = tick()
    end

    local t = rageLockedTarget or target
    if not t or not t.Character then return end

    aimAt(t)
    doAutoPeek(dt)
    fireWeapon()
end

function startRageBot()
    if rageConnections.rage then rageConnections.rage:Disconnect() end
    createFOVCircle()
    rageRemoteCache = buildRemoteCache()
    rageRemoteCacheTime = tick()
    rageConnections.rage = RunService.RenderStepped:Connect(rageBotLoop)
end

function stopRageBot()
    if rageConnections.rage then rageConnections.rage:Disconnect(); rageConnections.rage = nil end
    if rageFOVCircle then rageFOVCircle.Visible = false end
    rageLockedTarget = nil
    clearHitboxExpand()
    rageBacktrackCache = {}
end

