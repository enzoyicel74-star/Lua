local function getToolsInBackpack()
    local t = {}
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then for _, i in ipairs(bp:GetChildren()) do if i:IsA("Tool") then table.insert(t, i.Name) end end end
    return t
end
local function getToolsInCharacter()
    local t = {}
    if char then for _, i in ipairs(char:GetChildren()) do if i:IsA("Tool") then table.insert(t, i.Name) end end end
    return t
end
local function getAllTools()
    local t, seen = {}, {}
    for _, n in ipairs(getToolsInBackpack()) do if not seen[n] then seen[n] = true; table.insert(t, n) end end
    for _, n in ipairs(getToolsInCharacter()) do if not seen[n] then seen[n] = true; table.insert(t, n) end end
    return t
end
local function findTool(name)
    if not char then return nil end
    for _, i in ipairs(char:GetChildren()) do if i:IsA("Tool") and i.Name == name then return i end end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then for _, i in ipairs(bp:GetChildren()) do if i:IsA("Tool") and i.Name == name then return i end end end
    return nil
end
local function getEquippedTool()
    if not char then return nil end
    for _, i in ipairs(char:GetChildren()) do if i:IsA("Tool") then return i end end
    return nil
end

local function equipRageWeapon()
    local name
    if rageWeaponType == "Primary" then name = ragePrimaryW
    elseif rageWeaponType == "Secondary" then name = rageSecondaryW
    else name = rageMeleeW end
    if not name or name == "Auto" or name == "" then return end
    local equipped = getEquippedTool()
    if equipped and equipped.Name == name then return end
    local tool = findTool(name)
    if tool and hum and tool.Parent ~= char then pcall(function() hum:EquipTool(tool) end) end
end

local function buildRemoteCache()
    local cache = {}
    local keywords = {"fire","shoot","attack","hit","click","damage","dmg","bullet","weapon","gun","kill","slice","stab","swing","melee","ray","projectile","cast"}
    for _, remote in ipairs(ReplicatedStorage:GetDescendants()) do
        if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
            local n = remote.Name:lower()
            for _, kw in ipairs(keywords) do
                if n:find(kw) then table.insert(cache, {remote = remote, isFunc = remote:IsA("RemoteFunction")}) break end
            end
        end
    end
    return cache
end

local function getRemoteCache()
    if not rageRemoteCache or tick() - rageRemoteTime > 30 then
        rageRemoteCache = buildRemoteCache()
        rageRemoteTime = tick()
    end
    return rageRemoteCache
end

local function updateBacktrack()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not p.Character then rageBacktrackCache[p] = nil; continue end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        if not rageBacktrackCache[p] then rageBacktrackCache[p] = {} end
        local c = rageBacktrackCache[p]
        table.insert(c, {pos = hrp.Position, time = tick()})
        while #c > 0 and tick() - c[1].time > 0.3 do table.remove(c, 1) end
    end
end

local function getBacktrackPos(p)
    local c = rageBacktrackCache[p]
    if not c or #c == 0 then return nil end
    local targetTime = tick() - rageBacktrackT
    local best, bestDiff = nil, math.huge
    for _, entry in ipairs(c) do
        local diff = math.abs(entry.time - targetTime)
        if diff < bestDiff then bestDiff = diff; best = entry.pos end
    end
    return best
end

local function applyHitbox()
    if not rageHitbox then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        if not hrp:FindFirstChild("RageHitboxMarker") then
            pcall(function()
                hrp.Size = Vector3.new(rageHitboxSize, rageHitboxSize, rageHitboxSize)
                hrp.Transparency = 1
                hrp.CanCollide = false
                local marker = Instance.new("BoolValue")
                marker.Name = "RageHitboxMarker"
                marker.Parent = hrp
            end)
        end
    end
end

local function clearHitbox()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        local hrp = p.Character:FindFirstChild("HumanoidRootPart")
        if hrp and hrp:FindFirstChild("RageHitboxMarker") then
            pcall(function()
                hrp.Size = Vector3.new(2, 2, 1)
                hrp.Transparency = 1
                hrp.CanCollide = false
                hrp.RageHitboxMarker:Destroy()
            end)
        end
    end
end

local function fireRage()
    if not rageAutoFire then return end
    if tick() - rageLastShot < rageShootDelay then return end
    rageLastShot = tick()

    local tool = getEquippedTool()
    if tool then
        pcall(function() tool:Activate() end)
        for _, c in ipairs(tool:GetDescendants()) do
            if c:IsA("RemoteEvent") then pcall(function() c:FireServer() end) end
            if c:IsA("RemoteFunction") then pcall(function() c:InvokeServer() end) end
        end
    end

    for _, entry in ipairs(getRemoteCache()) do
        if entry.isFunc then pcall(function() entry.remote:InvokeServer() end)
        else pcall(function() entry.remote:FireServer() end) end
    end
end

local function silentTPKill(target)
    if not target or not target.Character or not root then return end
    local aimPart = getAimPart(target, rageAimPart)
    if not aimPart then return end

    local targetPos = aimPart.Position
    local savedCFrame = root.CFrame
    local savedCam = camera.CFrame

    local dir = (root.Position - targetPos)
    if dir.Magnitude < 0.01 then dir = Vector3.new(0, 0, 1) end
    local landing = Vector3.new(
        (targetPos + dir.Unit * rageTPDist).X,
        targetPos.Y + 2,
        (targetPos + dir.Unit * rageTPDist).Z
    )

    pcall(function()
        root.CFrame = CFrame.new(landing, targetPos)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)

    fireRage()

    task.delay(rageTPHold, function()
        pcall(function()
            if root then
                root.CFrame = savedCFrame
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
            camera.CFrame = savedCam
        end)
    end)
end

local function rageLoop(dt)
    if not rageEnabled or not root or not hum or hum.Health <= 0 then return end

    updateBacktrack()
    applyHitbox()
    equipRageWeapon()

    local target = scanTargets(rageFOV, rageAimPart, ragePriority, rageVisible, rageTeamCheck)
    if not target then rageLocked = nil; return end

    if rageLocked ~= target and tick() - rageLastSwitch > 0.1 then
        rageLocked = target
        rageLastSwitch = tick()
    end

    local t = rageLocked or target
    if not t or not t.Character then return end

    local aimPart = getAimPart(t, rageAimPart)
    if not aimPart then return end

    if rageTPEnabled then
        silentTPKill(t)
    else
        local targetPos = aimPart.Position
        if rageBacktrack then
            local bt = getBacktrackPos(t)
            if bt then targetPos = bt end
        end
        local desired = CFrame.new(camera.CFrame.Position, targetPos)
        camera.CFrame = desired
        if root then
            local look = targetPos - root.Position
            if look.Magnitude > 0.01 then
                root.CFrame = CFrame.new(root.Position, root.Position + Vector3.new(look.X, 0, look.Z))
            end
        end
        fireRage()
    end
end

function startRage()
    if rageConn then rageConn:Disconnect() end
    rageRemoteCache = buildRemoteCache()
    rageRemoteTime = tick()
    rageConn = RunService.RenderStepped:Connect(rageLoop)
end
function stopRage()
    if rageConn then rageConn:Disconnect(); rageConn = nil end
    rageLocked = nil
    clearHitbox()
    rageBacktrackCache = {}
end

