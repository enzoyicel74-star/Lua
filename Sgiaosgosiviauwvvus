-- FOV VISUAL
-- ============================================================

local function destroyFOV()
    if fovVisual.circle then fovVisual.circle:Remove(); fovVisual.circle = nil end
    if fovVisual.fillCircle then fovVisual.fillCircle:Remove(); fovVisual.fillCircle = nil end
end

local function createFOV()
    destroyFOV()
    local outer = Drawing.new("Circle")
    outer.Thickness = fovVisual.thickness
    outer.NumSides = fovVisual.sides
    outer.Radius = silentFOV
    outer.Filled = false
    outer.Transparency = fovVisual.transparency
    outer.Color = fovVisual.color
    outer.Visible = false
    fovVisual.circle = outer

    if fovVisual.filled then
        local inner = Drawing.new("Circle")
        inner.Thickness = 0
        inner.NumSides = fovVisual.sides
        inner.Radius = silentFOV
        inner.Filled = true
        inner.Transparency = fovVisual.fillAlpha
        inner.Color = fovVisual.color
        inner.Visible = false
        fovVisual.fillCircle = inner
    end
end

local function updateFOV(dt)
    if not fovVisual.circle then return end

    local shouldShow = fovVisual.enabled and (
        (silentEnabled and fovVisual.showOnSilent) or
        (aimbotEnabled and fovVisual.showOnAimbot) or
        (rageEnabled and fovVisual.showOnRage)
    )

    if not shouldShow then
        fovVisual.circle.Visible = false
        if fovVisual.fillCircle then fovVisual.fillCircle.Visible = false end
        return
    end

    local radius = silentFOV
    if rageEnabled and fovVisual.showOnRage then radius = rageFOV
    elseif silentEnabled and fovVisual.showOnSilent then radius = silentFOV
    elseif aimbotEnabled and fovVisual.showOnAimbot then radius = aimbotFOV end

    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

    if fovVisual.rotate then
        fovVisual.rotation = fovVisual.rotation + fovVisual.rotationSpeed * dt
    end

    fovVisual.circle.Position = center
    fovVisual.circle.Radius = radius
    fovVisual.circle.Color = fovVisual.color
    fovVisual.circle.Transparency = fovVisual.transparency
    fovVisual.circle.Thickness = fovVisual.thickness
    fovVisual.circle.NumSides = fovVisual.sides
    fovVisual.circle.Visible = true

    if fovVisual.fillCircle then
        fovVisual.fillCircle.Position = center
        fovVisual.fillCircle.Radius = radius
        fovVisual.fillCircle.Color = fovVisual.color
        fovVisual.fillCircle.Transparency = fovVisual.fillAlpha
        fovVisual.fillCircle.NumSides = fovVisual.sides
        fovVisual.fillCircle.Visible = true
    end
end

task.spawn(function()
    while true do
        local dt = RunService.RenderStepped:Wait()
        updateFOV(dt)
    end
end)

