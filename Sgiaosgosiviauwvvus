-- HELPERS
-- ============================================================

local function getAimPart(plr, part)
    if not plr.Character then return nil end
    if part == "Head" then
        return plr.Character:FindFirstChild("Head")
    elseif part == "UpperTorso" then
        return plr.Character:FindFirstChild("UpperTorso") or plr.Character:FindFirstChild("Torso")
    else
        return plr.Character:FindFirstChild("HumanoidRootPart")
    end
end

local function isVisible(targetPart)
    local origin = camera.CFrame.Position
    local dir = targetPart.Position - origin
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = {camera}
    if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
    params.FilterDescendantsInstances = filter
    local result = workspace:Raycast(origin, dir, params)
    if result then
        return result.Instance:IsDescendantOf(targetPart.Parent)
    end
    return true
end

local function pickScore(priority, p, screenPos, distToCenter, aimPart)
    if priority == "Health" then
        local h = p.Character:FindFirstChildOfClass("Humanoid")
        return h and h.Health or math.huge
    elseif priority == "Distance" then
        return (root.Position - aimPart.Position).Magnitude
    else
        return distToCenter
    end
end

local function scanTargets(fov, aimPartName, priority, visibleCheck, teamCheck)
    if not root then return nil end
    local best, bestScore = nil, math.huge
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if teamCheck and p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team then continue end
        if not p.Character then continue end

        local humanoid = p.Character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end

        local aimPart = getAimPart(p, aimPartName)
        if not aimPart then continue end

        local screenPos, onScreen = camera:WorldToViewportPoint(aimPart.Position)
        if not onScreen then continue end

        local distToCenter = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if distToCenter > fov then continue end

        if visibleCheck and not isVisible(aimPart) then continue end

        local score = pickScore(priority, p, screenPos, distToCenter, aimPart)
        if score < bestScore then
            bestScore = score
            best = p
        end
    end
    return best
end

-- ============================================================
-- SILENT AIM
-- ============================================================

local function silentLoop(dt)
    if not silentEnabled or not root or not hum or hum.Health <= 0 then return end
    local target = scanTargets(silentFOV, silentAimPart, silentPriority, silentVisible, silentTeamCheck)
    if not target then return end

    local aimPart = getAimPart(target, silentAimPart)
    if not aimPart then return end

    local desired = CFrame.new(camera.CFrame.Position, aimPart.Position)
    if silentSmoothing >= 1 then
        camera.CFrame = desired
    else
        camera.CFrame = camera.CFrame:Lerp(desired, silentSmoothing)
    end
end

function startSilent()
    if silentConn then silentConn:Disconnect() end
    silentConn = RunService.RenderStepped:Connect(silentLoop)
end
function stopSilent()
    if silentConn then silentConn:Disconnect(); silentConn = nil end
end

