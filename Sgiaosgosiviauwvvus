-- AIMBOT
-- ============================================================

local function aimbotLoop(dt)
    if not aimbotEnabled or not root or not hum or hum.Health <= 0 then return end

    local shouldAim = aimbotHold or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if not shouldAim then aimbotTarget = nil; return end

    local target = scanTargets(aimbotFOV, aimbotAimPart, aimbotPriority, aimbotVisible, aimbotTeamCheck)
    aimbotTarget = target
    if not target then return end

    local aimPart = getAimPart(target, aimbotAimPart)
    if not aimPart then return end

    local desired = CFrame.new(camera.CFrame.Position, aimPart.Position)
    camera.CFrame = camera.CFrame:Lerp(desired, aimbotSmooth)
end

function startAimbot()
    if aimbotConn then aimbotConn:Disconnect() end
    aimbotConn = RunService.RenderStepped:Connect(aimbotLoop)
end
function stopAimbot()
    if aimbotConn then aimbotConn:Disconnect(); aimbotConn = nil end
    aimbotTarget = nil
end

