-- RAGE STATUS DRAWING
-- ============================================================
local statusLine1 = Drawing.new("Text")
statusLine1.Size = 15; statusLine1.Font = 2; statusLine1.Outline = true; statusLine1.Center = true; statusLine1.Visible = false
statusLine1.Color = config.ragestatus.color; statusLine1.OutlineColor = Color3.new(0,0,0)

local statusLine2 = Drawing.new("Text")
statusLine2.Size = 15; statusLine2.Font = 2; statusLine2.Outline = true; statusLine2.Center = true; statusLine2.Visible = false
statusLine2.Color = config.ragestatus.color; statusLine2.OutlineColor = Color3.new(0,0,0)

local function statusAnchor()
    local cam = workspace.CurrentCamera
    if not cam then return Vector2.zero end
    return (cam.ViewportSize / 2) + Vector2.new(config.ragestatus.staticOffsetX or 0, config.ragestatus.staticOffsetY or 0)
end

RunService.RenderStepped:Connect(function()
    if not config.ragestatus.enabled then
        statusLine1.Visible = false
        statusLine2.Visible = false
        return
    end
    statusLine1.Size = config.ragestatus.textSize
    statusLine2.Size = config.ragestatus.textSize
    statusLine1.Color = config.ragestatus.color
    statusLine2.Color = config.ragestatus.color

    local line1, line2
    if config.state.reloading then
        line1 = "ragebot: reloading..."
    elseif config.voidspam.enabled and config.voidspam.phase == "hide" then
        line1 = "ragebot: void"
    elseif config.target.enabled and config.target.character then
        local nm = config.target.lastplayer and config.target.lastplayer.Name or "target"
        line1 = "ragebot: killing " .. nm .. "..."
    else
        line1 = "ragebot: idle"
    end

    local cur, maxA = getammo()
    local ammoStr = cur ~= nil and string.format("%d/%d", math.floor(cur), math.max(math.floor(maxA or 0), 0)) or "?/?"
    local hp = "?"
    if config.target.character then
        local h = config.target.character:FindFirstChildOfClass("Humanoid")
        if h then hp = string.format("%.0f", h.Health) end
    end
    local killStr = config.ragestatus.showKills and string.format(" [%d]", config.kills.count) or ""
    line2 = string.format("%s/%s%s", ammoStr, hp, killStr)

    local anchor = statusAnchor()
    local gap = config.ragestatus.lineGap
    statusLine1.Text = line1
    statusLine1.Position = anchor + Vector2.new(0, -gap/2)
    statusLine1.Visible = true
    statusLine2.Text = line2
    statusLine2.Position = anchor + Vector2.new(0, gap/2)
    statusLine2.Visible = true
end)

print("[Ragebot] Loaded for Linoria UI")
