-- ============================================================
local _lobbyCache = { t = 0, v = true }
local function liveMatch()
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if modules.fighter and modules.fighter.LocalFighter and modules.fighter.LocalFighter.Entity then
        return true
    end
    local myTeam = LocalPlayer:GetAttribute("TeamID")
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local h = p.Character:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 and myTeam ~= nil and p:GetAttribute("TeamID") ~= myTeam then
                return true
            end
        end
    end
    return false
end
local function lobbyCache()
    local now = os.clock()
    if now - _lobbyCache.t < 0.15 then return _lobbyCache.v end
    _lobbyCache.t = now
    _lobbyCache.v = not liveMatch()
    return _lobbyCache.v
end

